---
// src/components/mobile/PhotoCarousel.astro - UPDATED
interface Props {
  stills: string[];
  title: string;
  videoSlug: string;
  country: string;
  year: string;
}

const { stills, title, videoSlug, country, year } = Astro.props;

const getThumbnail = (image: string) => {
  return image.replace('.webp', '-thumb.webp');
};
---

<div class="mobile-photo-carousel">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-xs font-medium text-gray-500 uppercase tracking-widest">
      Film Stills • {stills.length} images
    </h3>
    <span class="text-xs text-gray-400">Swipe →</span>
  </div>
  
  {stills.length > 0 ? (
    <div class="relative">
      <div class="overflow-x-auto snap-x snap-mandatory scrollbar-hide">
        <div class="flex">
          {stills.map((image, index) => (
            <div class="flex-shrink-0 w-full snap-center px-4 box-border">
              <!-- GLightbox link wrapper (SAME AS DESKTOP) -->
              <a
                href={image}
                class="glightbox block"
                data-gallery={videoSlug}
                data-description={`${country} ${year}`}
              >
                <div class="relative rounded-xl overflow-hidden bg-gray-100 aspect-[16/9]">
                  <img
                    src={getThumbnail(image)}
                    alt={`Still ${index + 1} from ${title}`}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    width="375"
                    height="211"
                  />
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  ) : (
    <p class="text-gray-400 text-sm italic py-8 text-center">No stills available</p>
  )}
  
  <style>
    .mobile-photo-carousel {
      touch-action: pan-x pinch-zoom;
    }
    
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
    
    .mobile-photo-carousel > div > div {
      width: 100%;
    }
    
    .mobile-photo-carousel .snap-center {
      width: 100%;
      scroll-snap-align: center;
    }
    
    /* Ensure GLightbox links look correct */
    a.glightbox {
      text-decoration: none;
      color: inherit;
      display: block;
    }
    
    @media (min-width: 769px) {
      .mobile-photo-carousel {
        display: none;
      }
    }
  </style>
</div>