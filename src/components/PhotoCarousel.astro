---
// src/components/PhotoCarousel.astro - CORRECTED
interface Props {
  stills: string[];
  title: string;
  videoSlug: string;    // Make sure this is passed
  country: string;      // Make sure this is passed  
  year: string;         // Make sure this is passed
}

const { stills, title, videoSlug, country, year } = Astro.props;

// Helper to get thumbnail
const getThumbnail = (image: string) => {
  return image.replace('.webp', '-thumb.webp');
};
---

<div class="photo-carousel mt-6">
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-xs font-medium text-gray-500 uppercase tracking-widest">
      Film Stills • {stills.length} images
    </h3>
    <span class="text-xs text-gray-400">Scroll →</span>
  </div>
  
  {stills.length > 0 ? (
    <div class="relative">
      <div class="flex space-x-3 overflow-x-auto pb-4 scrollbar-hide snap-x snap-mandatory">
        {stills.map((image, index) => (
          <div class="flex-shrink-0 w-64 snap-center">
            <!-- CRITICAL: Add the GLightbox link wrapper -->
            <a
              href={image}  
              class="glightbox block"
              data-gallery={videoSlug}
              data-description={`${country} ${year}`}
            >
              <div class="relative rounded overflow-hidden bg-gray-100 aspect-[16/9] group">
                <img
                  src={getThumbnail(image)}
                  alt={`Still ${index + 1} from ${title}`}
                  class="w-full h-full object-cover transition-all duration-400 ease-out group-hover:scale-105"
                  loading="lazy"
                  width="384"
                  height="216"
                />
                <!-- Overlay gradient -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <!-- Number badge -->
                <div class="absolute top-2 right-2 bg-black/80 text-white text-xs font-medium px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  {index + 1}/{stills.length}
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  ) : (
    <p class="text-gray-400 text-sm italic">No stills available</p>
  )}
</div>