---
// src/components/Footer.astro
import Icons from './Icons.astro';

const currentYear = new Date().getFullYear();
---

<footer class="py-6 px-4 sm:px-8 border-t border-gray-300 bg-white">
  <div class="max-w-3xl mx-auto text-center">
    <!-- Main footer text -->
    <div class="mb-4">
      <p class="text-gray-500 text-sm mb-1">
        Travel Video Portfolio • {currentYear}
      </p>
      <p class="text-gray-400 text-xs">
        All videos shot and edited by Jon Ugarte
      </p>
    </div>
 
    <!-- Alternative subtle version -->
    <a 
    href="https://github.com/JonUXD/ju-travel-video" 
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 text-gray-500 hover:text-gray-700 text-sm transition-colors duration-200 group"
    aria-label="View source code on GitHub"
    >
    <Icons name="github" className="w-4 h-4 group-hover:scale-110 transition-transform" />
    <span class="border-b border-transparent hover:border-gray-400 transition-border">
        View source code
    </span>
    </a>
  </div>
</footer>