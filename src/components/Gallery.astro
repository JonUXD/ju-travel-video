---
// src/components/Gallery.astro - UPDATED with better arrow visibility
// Gallery component initializes GLightbox with custom styling
// Include this component once on any page that needs the gallery
---

<style>
  /* GLightbox Custom Styling - Clean, matches your monochrome aesthetic */
  
  /* 1. OVERLAY - Dark cinematic background */
  :global(.glightbox-container) {
    background: rgba(10, 10, 10, 0.98) !important;
    backdrop-filter: blur(4px) !important;
  }
  
  /* 2. SLIDE CONTAINER - Clean white frame */
  :global(.gslide) {
    background: white !important;
    border-radius: 8px !important;
    overflow: hidden !important;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3) !important;
  }
  
  /* 3. IMAGE - Proper sizing and constraints */
  :global(.gslide-image) {
    display: block !important;
    margin: 0 auto !important;
    max-height: 85vh !important;
    max-width: 85vw !important;
    object-fit: contain !important;
  }
  
  /* 4. NO CAPTIONS (as requested) */
  :global(.gslide-description) {
    display: none !important;
  }
  
  /* 5. NAVIGATION ARROWS - COMPLETE REDESIGN for visibility */
  :global(.gbtn) {
    opacity: 0.9 !important;
    transition: all 0.2s ease !important;
    background: rgba(0, 0, 0, 0.7) !important;
    width: 56px !important;
    height: 56px !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  
  :global(.gbtn:hover) {
    opacity: 1 !important;
    background: rgba(0, 0, 0, 0.9) !important;
    transform: scale(1.05) !important;
  }
  
  :global(.gbtn svg) {
    fill: white !important;
    width: 24px !important;
    height: 24px !important;
    filter: none !important;
    stroke: none !important;
  }
  
  /* Position arrows closer to edges */
  :global(.gnext) {
    right: 24px !important;
  }
  
  :global(.gprev) {
    left: 24px !important;
  }
  
  /* 6. CLOSE BUTTON - Custom X design with dark background */
  :global(.glightbox-close) {
    top: 24px !important;
    right: 24px !important;
    width: 56px !important;
    height: 56px !important;
    background: rgba(0, 0, 0, 0.7) !important;
    border-radius: 50% !important;
    font-size: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.2s ease !important;
  }
  
  :global(.glightbox-close:hover) {
    background: rgba(0, 0, 0, 0.9) !important;
    transform: scale(1.05) !important;
  }
  
  :global(.glightbox-close:before),
  :global(.glightbox-close:after) {
    content: '' !important;
    position: absolute !important;
    width: 24px !important;
    height: 2px !important;
    background: white !important;
    border-radius: 1px !important;
    opacity: 0.9 !important;
    transition: opacity 0.2s ease !important;
  }
  
  :global(.glightbox-close:before) {
    transform: rotate(45deg) !important;
  }
  
  :global(.glightbox-close:after) {
    transform: rotate(-45deg) !important;
  }
  
  :global(.glightbox-close:hover:before),
  :global(.glightbox-close:hover:after) {
    opacity: 1 !important;
  }
  
  /* 7. LOADING INDICATOR */
  :global(.gloader) {
    border-color: rgba(255, 255, 255, 0.2) rgba(255, 255, 255, 0.2) white white !important;
  }
  
  /* 8. MOBILE OPTIMIZATIONS */
  @media (max-width: 768px) {
    :global(.gslide) {
      border-radius: 0 !important;
      max-width: 100vw !important;
      max-height: 100vh !important;
    }
    
    :global(.gslide-image) {
      max-height: 100vh !important;
      max-width: 100vw !important;
    }
    
    :global(.gbtn) {
      width: 48px !important;
      height: 48px !important;
      background: rgba(0, 0, 0, 0.8) !important;
    }
    
    :global(.gbtn svg) {
      width: 20px !important;
      height: 20px !important;
    }
    
    :global(.glightbox-close) {
      width: 48px !important;
      height: 48px !important;
      top: 16px !important;
      right: 16px !important;
    }
    
    :global(.glightbox-close:before),
    :global(.glightbox-close:after) {
      width: 20px !important;
    }
  }
</style>

<script>
  // Initialize GLightbox with our custom settings
  import GLightbox from 'glightbox';
  import 'glightbox/dist/css/glightbox.min.css';
  
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', () => {
    const lightbox = GLightbox({
      // Basic functionality
      touchNavigation: true,
      loop: true,
      zoomable: true,
      
      // UI preferences
      moreLength: 0,
      closeButton: true,
      
      // Animation settings
      openEffect: 'fade',
      closeEffect: 'fade',
      slideEffect: 'slide',
      cssEffects: {
        fade: { in: 'fadeIn', out: 'fadeOut' },
        slide: { in: 'slideInRight', out: 'slideOutLeft' }
      },
      
      // Performance - preload next and previous images
      preload: true,
      
      // Video handling
      autoplayVideos: false,
    });
    
  });
</script>