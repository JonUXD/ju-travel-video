---
// src/components/VideoSection.astro
import type { Video } from '../data/index';
import PhotoCarousel from './PhotoCarousel.astro';

interface Props {
  video: Video;
}

const { video } = Astro.props;
---

<section class="video-section mb-20 pb-12 border-b border-gray-100 last:border-b-0">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
    <!-- Left Column: Video Player -->
    <div class="video-player">
      <div class="relative pb-[56.25%] bg-black rounded-xl overflow-hidden shadow-lg">
        <iframe
          src={`https://www.youtube.com/embed/${video.youtubeId}?modestbranding=1&rel=0`}
          title={video.title}
          class="absolute top-0 left-0 w-full h-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <PhotoCarousel stills={video.stills} title={video.title} />
    </div>

    <!-- Right Column: Metadata -->
    <div class="metadata lg:pl-4">
      <div class="mb-6">
        <h2 class="text-3xl font-bold text-gray-900 mb-3 tracking-tight">{video.title}</h2>
        <p class="text-gray-600 leading-relaxed">{video.description}</p>
      </div>

      <!-- Basic Info Grid -->
      <div class="grid grid-cols-2 gap-5 mb-8">
        <div>
          <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Location</h3>
          <p class="text-gray-800 font-medium">{video.metadata.places.join(', ')}</p>
        </div>
        <div>
          <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Date</h3>
          <p class="text-gray-800 font-medium">
            {new Date(video.metadata.date).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
          </p>
        </div>
        <div>
          <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Country</h3>
          <p class="text-gray-800 font-medium">{video.metadata.country}</p>
        </div>
        <div>
          <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Gear</h3>
          <p class="text-gray-800 font-medium text-sm">{video.metadata.gear}</p>
        </div>
      </div>

      <!-- Music Info -->
      <div class="music-info p-5 bg-gray-50 rounded-xl border border-gray-200">
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Music</h3>
        <p class="text-gray-800 font-medium text-lg mb-2">
          {video.metadata.music.artist} – {video.metadata.music.title}
        </p>
        <div class="flex gap-5">
          <a 
            href={video.metadata.music.spotify} 
            target="_blank" 
            class="text-sm text-gray-600 hover:text-gray-900 flex items-center gap-1"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.601-1.559.3z"/>
            </svg>
            Spotify
          </a>
          <a 
            href={video.metadata.music.youtube} 
            target="_blank" 
            class="text-sm text-gray-600 hover:text-gray-900 flex items-center gap-1"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
            </svg>
            YouTube
          </a>
        </div>
      </div>
    </div>
  </div>
</section>