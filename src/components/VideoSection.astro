---
// src/components/VideoSection.astro - Updated with flexible location cell
import type { Video } from '../data/index';
import PhotoCarousel from './PhotoCarousel.astro';
import Icons from './Icons.astro';

interface Props {
  video: Video;
}

const { video } = Astro.props;
---

<section class="video-section mb-12 pb-8 last:mb-0 last:pb-0">
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 mb-8">
    <!-- Left Column: Video -->
    <div class="lg:col-span-2">
      <div class="w-full max-w-2xl">
        <div class="relative pb-[56.25%] bg-black rounded-lg overflow-hidden shadow-md">
          <iframe
            src={`https://www.youtube.com/embed/${video.youtubeId}?modestbranding=1&rel=0`}
            title={video.title}
            class="absolute top-0 left-0 w-full h-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>

    <!-- Right Column: Metadata - 4x2 grid + music -->
    <div class="lg:col-span-2 lg:pl-4">
      
      <!-- 4x2 GRID: 4 columns wide, 2 rows tall -->
      <div class="grid grid-cols-4 grid-rows-[minmax(0,_auto)_minmax(0,_auto)] gap-5 mb-6">
        
        <!-- CELL 1: Location (row 1, col 1) - ALLOW EXPANSION -->
        <div class="space-y-2 min-h-0 self-start">
          <div class="flex items-center gap-2 text-gray-500">
            <Icons name="location" className="w-3.5 h-3.5" />
            <span class="text-xs font-medium uppercase tracking-wider">Location</span>
          </div>
          <p class="text-gray-800 font-medium text-sm">
            {video.metadata.places.join(', ')}
          </p>
        </div>

        <!-- CELL 2: Date (row 1, col 2) - FIXED HEIGHT -->
        <div class="space-y-2 min-h-0">
          <div class="flex items-center gap-2 text-gray-500">
            <Icons name="calendar" className="w-3.5 h-3.5" />
            <span class="text-xs font-medium uppercase tracking-wider">Date</span>
          </div>
          <p class="text-gray-800 font-medium text-sm">
            {new Date(video.metadata.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
          </p>
        </div>

        <!-- CELLS 3 & 4: GEAR (row 1-2, col 3-4 - spans 2 rows × 2 columns) -->
        <div class="col-span-2 row-span-2 space-y-1 min-h-0 self-start">
          <div class="flex items-center gap-2 text-gray-500 mb-2">
            <Icons name="gear" className="w-3.5 h-3.5" />
            <span class="text-xs font-medium uppercase tracking-wider">Gear</span>
          </div>
          <p class="text-gray-700 text-xs leading-relaxed line-clamp-4">
            {video.metadata.camera}{video.metadata.gear ? `, ${video.metadata.gear}` : ''}
          </p>
        </div>

        <!-- CELL 5: Country (row 2, col 1) - FIXED HEIGHT -->
        <div class="space-y-2 min-h-0">
          <div class="flex items-center gap-2 text-gray-500">
            <Icons name="country" className="w-3.5 h-3.5" />
            <span class="text-xs font-medium uppercase tracking-wider">Country</span>
          </div>
          <p class="text-gray-800 font-medium text-sm line-clamp-1">
            {video.metadata.country}
          </p>
        </div>

        <!-- CELL 6: Region (row 2, col 2) - FIXED HEIGHT -->
        <div class="space-y-2 min-h-0">
          <div class="flex items-center gap-2 text-gray-500">
            <Icons name="region" className="w-3.5 h-3.5" />
            <span class="text-xs font-medium uppercase tracking-wider">Region</span>
          </div>
          <p class="text-gray-800 font-medium text-sm line-clamp-1">
            {video.metadata.region}
          </p>
        </div>
        
      </div> <!-- End 4x2 grid -->

      <!-- Separator line -->
      <div class="border-t border-gray-200 my-8"></div>

      <!-- Music Section -->
      <div class="space-y-3">
        <div class="flex items-center gap-2 text-gray-500">
          <Icons name="music" className="w-3.5 h-3.5" />
          <span class="text-xs font-medium uppercase tracking-wider">Music</span>
        </div>
        
        <!-- Music details -->
        <div>
          <!-- Row 1: Artist + Links (inline) -->
          <div class="flex items-center gap-8 mb-1">
            <!-- Artist name -->
            <p class="text-gray-900 font-medium text-sm flex-shrink-0">{video.metadata.music.artist}</p>
            
            <!-- Spotify and YouTube links -->
            <div class="flex gap-6 items-center">
              <a 
                href={video.metadata.music.spotify} 
                target="_blank" 
                class="text-gray-600 hover:text-gray-900 inline-flex items-center gap-2 transition-colors"
              >
                <Icons name="spotify" className="w-4 h-4" />
                <span class="text-sm">Spotify</span>
              </a>
              <a 
                href={video.metadata.music.youtube} 
                target="_blank" 
                class="text-gray-600 hover:text-gray-900 inline-flex items-center gap-2 transition-colors"
              >
                <Icons name="youtube" className="w-4 h-4" />
                <span class="text-sm">YouTube</span>
              </a>
            </div>
          </div>
          
          <!-- Row 2: Song title -->
          <p class="text-gray-600 text-sm">{video.metadata.music.title}</p>
        </div>
      </div>
      
    </div> <!-- End right column -->
    
  </div> <!-- End main grid -->

  <!-- Photo Carousel Below (Full width) -->
  <div class="mt-6">
  <PhotoCarousel 
    stills={video.stills} 
    title={video.title}
    videoSlug={video.slug}
    country={video.metadata.country}
    year={new Date(video.metadata.date).getFullYear().toString()}
  />
  </div>
</section>