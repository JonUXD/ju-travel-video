---
// src/pages/index.astro - FINAL CORRECT VERSION
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileHeader from '../components/mobile/Header.astro';
import VideoSection from '../components/VideoSection.astro';
import MobileVideoSection from '../components/mobile/VideoSection.astro';
import Footer from '../components/Footer.astro';
import Frame from '../components/Frame.astro';
import Gallery from '../components/Gallery.astro'; // ADD THIS IMPORT
import { sortedVideos } from '../data/index';
---

<Layout>
  <!-- Include Gallery component once -->
  <Gallery />
  
  <main class="min-h-screen bg-gradient-to-b from-gray-100 to-white">
    <!-- DESKTOP HEADER (hidden on mobile) -->
    <div class="hidden md:block">
      <Header sortedVideos={sortedVideos} />
    </div>

    <!-- MOBILE HEADER (hidden on desktop) -->
    <div class="block md:hidden">
      <MobileHeader sortedVideos={sortedVideos} />
    </div>

    <!-- DESKTOP VIDEOS -->
    <div class="hidden md:block">
      <div class="max-w-6xl mx-auto px-4 sm:px-8 pb-12">
        <div class="space-y-8">
          {sortedVideos.map((video) => (
            <Frame>
              <VideoSection video={video} />
            </Frame>
          ))}
        </div>
      </div>
    </div>

    <!-- MOBILE VIDEOS -->
    <div class="block md:hidden">
      <div class="px-4 pb-12">
        <div class="space-y-4">
          {sortedVideos.map((video) => (
            <MobileVideoSection video={video} />
          ))}
        </div>
      </div>
    </div>

    <!-- FOOTER (desktop only) -->
    <div class="hidden md:block">
      <Footer />
    </div>
  </main>
</Layout>