---
// src/pages/index.astro - UPDATED HEADER with film icon
import Layout from '../layouts/Layout.astro';
import VideoSection from '../components/VideoSection.astro';
import { sortedVideos } from '../data/index';
import Frame from '../components/Frame.astro'
import Icons from '../components/Icons.astro';
---

<Layout>
  <main class="min-h-screen bg-gradient-to-b from-gray-100 to-white">
    <!-- Header - Centered -->
    <header class="py-12 pb-4 px-4 sm:px-8 text-center">
      <div class="max-w-3xl mx-auto">
        <div class="mb-4">
          <span class="text-xs font-medium text-gray-500 uppercase tracking-widest">JON UGARTE</span>
        </div>
        <h1 class="text-4xl font-light text-gray-900 tracking-tight mb-4">
          Travel Videos
        </h1>
        
        <!-- Simple Stats - Using consistent icons from Icons component -->
        <div class="flex flex-wrap justify-center items-center gap-6 text-sm text-gray-600">
          <span class="inline-flex items-center gap-2">
            <Icons name="film" className="w-4 h-4" />
            {sortedVideos.length} videos
          </span>
          
          <span class="inline-flex items-center gap-2">
            <Icons name="country" className="w-4 h-4" />
            {new Set(sortedVideos.map(v => v.metadata.country)).size} countries
          </span>
          
          <span class="inline-flex items-center gap-2">
            <Icons name="gear" className="w-4 h-4" />
            {sortedVideos.reduce((sum, video) => sum + video.stills.length, 0)} stills
          </span>
        </div>
      </div>
    </header>

    <!-- Video Sections -->
    <div class="max-w-6xl mx-auto px-4 sm:px-8 pb-12">
      <div class="space-y-8">
        {sortedVideos.map((video, index) => (
          <Frame>
            <VideoSection video={video} />
          </Frame>
        ))}
      </div>
    </div>

    <!-- Footer - centered -->
    <footer class="py-6 px-4 sm:px-8 border-t border-gray-300 bg-white">
      <div class="max-w-3xl mx-auto text-center text-gray-500 text-sm">
        <p class="mb-1">Travel Video Portfolio • {new Date().getFullYear()}</p>
        <p class="text-xs">All videos shot and edited by Jon Ugarte</p>
      </div>
    </footer>
  </main>
</Layout>